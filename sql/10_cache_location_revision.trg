CREATE OR REPLACE TRIGGER WH_CACHE_LOCATION_REV_TRG
AFTER INSERT OR UPDATE OR DELETE ON WH_SEC_LOCATION
BEGIN
    UPDATE WH_CACHE_STATE
       SET ACCESS_REVISION = ACCESS_REVISION + 1,
           UPDATED_AT = SYSTIMESTAMP
     WHERE STATE_ID = 1;
    IF SQL%ROWCOUNT <> 1 THEN
        RAISE_APPLICATION_ERROR(-20220, 'Cache access revision is unavailable.');
    END IF;
END;
