# Copy to .env and set values locally. Never commit .env or share the password.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=tcps://db.freesql.com:2484/your_service_name
ORACLE_POOL_MAX=4

# Use portable after installing the catalog and registering your own WH_ views.
APP_MODE=demo

# Optional: freeze relative periods for the synthetic Q3 2026 demo.
DEMO_AS_OF_DATE=2026-10-28
