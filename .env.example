# Copy to a local, git-ignored .env. Never commit credentials or access tokens.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=tcps://db.freesql.com:2484/your_service_name
ORACLE_POOL_MAX=4

# demo is synthetic. portable requires the catalog, security schema, users,
# location grants, and certified metrics over your own WH_ adapter views.
APP_MODE=demo

# Optional: freeze relative periods for the synthetic Q3 2026 demo.
DEMO_AS_OF_DATE=2026-10-28

# Optional admin-only Select AI SQL preview in portable mode. Keep disabled
# until an owned, restricted AI profile has been created and verified.
SELECT_AI_ENABLED=false
SELECT_AI_PROFILE=WH_SELECT_AI_EXPLORE

# Setup script only: inject from a secret manager or fill locally when creating
# an Oracle provider credential. Do not pass this into the app container.
SELECT_AI_API_KEY=
